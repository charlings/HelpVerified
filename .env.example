# Web section: copy to apps/web/.env.local for local development. Only NEXT_PUBLIC_* keys may be used by the web app.
# The API section at the bottom goes in apps/api/.env.

# Public site URL, used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL (Phase 2). Ignored while mocking is enabled.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# "enabled" runs the app against MSW mocks (Phase 1). Any other value uses the real API.
NEXT_PUBLIC_API_MOCKING=enabled

# Paystack public key — use a pk_test_ key outside production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Cloudinary cloud name (public)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace_me

# ---------------------------------------------------------------------------
# API (apps/api). Copy this section to apps/api/.env for local development.
# Keys are added in the milestone that first uses them (ADR 0010). The API refuses
# to start if a required key is missing, and names it.
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000

# PostgreSQL 16 via asyncpg. Matches docker-compose.yml and apps/api/scripts/pg-portable.ps1 (local only).
DATABASE_URL=postgresql+asyncpg://helpverified:helpverified@localhost:5432/helpverified
# Redis 7: rate limits (B2). Matches docker-compose.yml and apps/api/scripts/redis-portable.ps1.
REDIS_URL=redis://localhost:6379/0

# Signs access tokens (HS256). At least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_me_with_a_random_string_of_at_least_32_characters

# HMAC key for worker NINs (only the keyed hash and last 4 digits are stored). At least 32 characters,
# generated like JWT_SECRET. Treat it as permanent: changing it needs every NIN re-hashed.
NIN_PEPPER=replace_me_with_a_random_string_of_at_least_32_characters

# Paystack (B5). From the dashboard, Settings → API Keys & Webhooks, in TEST mode. A live key (sk_live_...)
# is refused unless APP_ENV=production. The secret key also verifies webhook signatures.
PAYSTACK_SECRET_KEY=sk_test_replace_me
# A monthly plan created in Paystack (Payments → Plans). Agency subscriptions need it; fees don't.
PAYSTACK_AGENCY_PLAN_CODE=
# Prices in kobo (₦1 = 100 kobo). Defaults are the frontend's demo prices; the plan's price must match.
PLACEMENT_FEE_KOBO=2000000
AGENCY_SUBSCRIPTION_KOBO=2500000

# Cloudinary (B3): worker photos and verification documents. From the Cloudinary console, "API Keys".
# The API secret signs uploads and download links; it never reaches the browser.
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Google sign-in (ADR 0016). Optional: leave both empty and "Continue with Google" reports it's unavailable.
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application). Its authorised
# redirect URI must be API_BASE_URL + /api/v1/auth/google/callback exactly, e.g.
#   http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (defaults shown)
# Minutes allowed on Google's consent screen, and for a new Google user to choose family or agency
GOOGLE_FLOW_TTL_MIN=10
GOOGLE_PENDING_TTL_MIN=15
# Placement rules (B4). Business defaults the owner may change: see CLAUDE.md "Open decisions".
TRIAL_DAYS_DEFAULT=14
# Replacement allowed during the trial and this many days after confirming
REPLACEMENT_WINDOW_DAYS=30
# Replacements whose placement fee is waived, per fee paid
FREE_REPLACEMENTS=1
# An unpaid accept holds the worker this long before the placement is cancelled
PAYMENT_HOLD_MINUTES=30
# The fee is charged when the family accepts (owner decision, ADR 0013)
FEE_CHARGED_AT=accept
# How long Idempotency-Key responses are remembered
IDEMPOTENCY_TTL_HOURS=24
# Document download links stay valid for this many seconds (max 3600)
CLOUDINARY_SIGNED_URL_TTL_SEC=300
# References and address checks must be re-verified after this many months; ID and guarantor don't expire
VERIFICATION_TTL_MONTHS=12
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14
VERIFY_EMAIL_TTL_HOURS=24
RESET_PASSWORD_TTL_MIN=60
# Login and signup per IP + email; reset and resend per email; signed-in calls per user
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_EMAIL_PER_HOUR=3
RATE_LIMIT_USER_PER_MIN=120
# The public contact form, per IP
RATE_LIMIT_CONTACT_PER_HOUR=5
# Email (B6). "outbox" writes emails as JSON files to EMAIL_OUTBOX_DIR (development only; refused in
# staging/production): open the newest file there to follow a verify or reset link. "smtp" sends through
# your provider's SMTP relay (Resend, Brevo, Postmark, SendGrid...); it needs the SMTP_* keys below.
# EMAIL_FROM must use a domain verified with the provider.
EMAIL_PROVIDER=outbox
EMAIL_FROM=HelpVerified <no-reply@helpverified.local>
EMAIL_OUTBOX_DIR=.outbox
# 587 = STARTTLS, 465 = TLS. If the host blocks those ports, most providers also accept 2525.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Contact-form messages are emailed here (Reply-To is the sender). Required in staging/production.
# Unset in development: the outbox gets them; with SMTP they're not sent.
CONTACT_INBOX=
# Demo seed (development and test only): `cd apps/api && uv run python -m app.scripts.seed --reset`.
# Choose your own passwords; the admin one falls back to the demo one when empty.
SEED_DEMO_PASSWORD=
SEED_ADMIN_PASSWORD=
# Notifications (B6). The feed is stored in PostgreSQL and served by /api/v1/notifications. "firestore"
# also mirrors it to Firestore for a live feed; it needs the project ID and a service-account JSON key
# (Firebase console → Project settings → Service accounts). Keep the key file OUTSIDE the repository.
NOTIFICATIONS_MIRROR=none
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=
# A notification whose email or mirror keeps failing is given up after this many attempts
NOTIFICATION_MAX_ATTEMPTS=8
# Jobs (B6): hold expiry, reminders, check expiry, subscription sync, retries, retention. Locally they run
# inside the API; run one by hand with `uv run python -m app.jobs run <name>` (`list` shows them all).
# On Render they run as Render Cron Jobs instead (owner, 2026-10-13): set JOBS_ENABLED=false on the web service.
JOBS_ENABLED=true
# Families and agencies are reminded this many days before a trial ends
TRIAL_REMINDER_DAYS=2
# A refund Paystack keeps refusing is left for an admin after this many attempts (it's logged)
REFUND_MAX_ATTEMPTS=10
# Retention (NDPA): evidence of rejected checks, and of unlisted workers with nothing happening for this
# long, is deleted (and destroyed in Cloudinary). Owner-decided 2026-10-11 and 2026-10-13.
RETENTION_REJECTED_EVIDENCE_DAYS=90
RETENTION_IDLE_WORKER_MONTHS=12
LOG_LEVEL=INFO
# Largest accepted request body in bytes (1 MB)
MAX_BODY_BYTES=1048576
