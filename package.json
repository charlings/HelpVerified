{
  "name": "helpverified",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "scripts": {
    "dev": "bun --filter web dev",
    "build": "bun --filter web build",
    "lint": "bun --filter web lint",
    "typecheck": "bun --filter web typecheck",
    "test": "bun --filter web test",
    "contracts:generate": "cd apps/api && uv run python -m scripts.export_openapi ../../packages/contracts/openapi.json && cd ../.. && bun --filter @helpverified/contracts generate"
  }
}
