{
  "name": "web",
  "sideEffects": [
    "*.css",
    "**/features/auth/client.ts"
  ],
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand": "tsx scripts/brand.mts",
    "images": "tsx scripts/images.mts",
    "lighthouse": "tsx scripts/lighthouse.mts",
    "bundle:check": "tsx scripts/bundle-budget.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "msw": "^3.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
